NODE_ENV=production
PORT=3000

TELEGRAM_BOT_TOKEN=123456:ABCDEF_your_bot_token
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

NEON_DATABASE_URL=postgres://user:password@host/db
# or DATABASE_URL=postgres://user:password@host/db
DB_CONNECTION_LIMIT=20

REDIS_URL=redis://default:password@host:6379
REDIS_PREFIX=otp:

EXTERNAL_API_BASE=https://example.com
EXTERNAL_API_ACCOUNT=your_account
EXTERNAL_API_PASSWORD=your_password
EXTERNAL_API_IDENTITY=Member
TOKEN_REFRESH_BUFFER_MS=600000
TOKEN_TTL_MS=18000000

ALLOWED_ORIGINS=https://your-frontend.vercel.app